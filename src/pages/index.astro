---
// Placeholder index while the site is built out (launch plan Phase E).
// The real homepage spec: Mycelium repo, docs/website-concept.md.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LBM Labs</title>
    <style>
      body {
        margin: 0; min-height: 100vh; display: grid; place-items: center;
        background: #0c120e; color: #e8f3ec;
        font: 16px/1.6 ui-monospace, "SF Mono", Menlo, monospace;
      }
      main { text-align: center; padding: 2rem; }
      h1 { font-weight: 500; letter-spacing: 0.02em; }
      a { color: #9ff5c9; }
      p { color: #8aa194; }
    </style>
  </head>
  <body>
    <main>
      <h1>LBM Labs</h1>
      <p>A public-good lab. Site under construction.</p>
      <p><a href={`${base}/prototypes/mycelium-hero.html`}>hero animation prototype →</a></p>
    </main>
  </body>
</html>
