---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
/* /build (B2). The on-ramp, three tiers. Voice: Conor's own, plain and
   first-person, matched to the /why page and homepage copy (not the old
   copy-build.md tone). Photo slots = C4. Costs from bom.md. */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/LBM-Labs/Mycelium_Network";          // A7
const guide = `${base}/build/bench-leaf`;  // the rendered bench-leaf guide
const gatewayGuide = `${base}/build/gateway`;  // the rendered gateway guide
const pairingGuide = `${base}/build/pairing`;  // the rendered pairing guide
const tiers = [
  {
    n: "Tier 1", title: "The bench leaf", cost: "v0.5 · ~$218 · one afternoon",
    img: `${base}/leaf.jpg`,
    alt: "The v0.5 leaf in an open tan waterproof case: a Raspberry Pi, an EnviroDIY Mayfly, a LoRa radio with its 915 MHz antenna, and a USB battery bank, foam-mounted.",
    caption: "The v0.5 leaf, with a Pi, the Mayfly, the LoRa radio, and a battery bank in a waterproof case. No solar yet.",
    body: "This is the smallest build, but it still runs the entire pipeline. A $7 thermometer feeds a Mayfly logger, your Pi encrypts each reading with AES-256-GCM, a LoRa radio carries it to your gateway, and it lands in a Google Sheet you own. A status LED blinks the whole time so you can watch it working. The v0.5 build lives in a waterproof case and runs off a USB battery bank, so it is portable for short field runs, with no solar yet and no soldering.",
    aside: "This is the build that teaches you the system. Pinch the thermistor between your fingers for a minute and you should watch the next few readings climb in your spreadsheet.",
    rows: [
      ["Build guide", "full parts list + step-by-step", guide],
      ["You'll need", "a laptop, a micro-SD reader, an afternoon", null],
    ],
    rule: "There is one rule before you start. Never power the radio without its antenna attached. The guide repeats this a few times because it really does matter.",
  },
  {
    n: "Tier 2", title: "The gateway", cost: "a Pi you supply + a ~$25 radio",
    img: `${base}/gateway.jpg`,
    alt: "A Raspberry Pi 4 wired to a LILYGO LoRa radio with its antenna attached, sitting on a workbench.",
    caption: "The first gateway, a Raspberry Pi 4 and a LoRa radio.",
    body: "A leaf on its own is just a sensor. A gateway is what turns it into a network. The gateway is a Pi you supply (a Pi 4 is what I test on, but a spare Pi Zero 2 W works too) plus the same $25 LoRa radio the leaf uses. It listens for encrypted readings over LoRa and forwards them to your destination over WiFi, behind a host allowlist and a per-sensor rate limit. It also announces itself so nearby leaves can find it. Once it is running, pair it with your bench leaf and you can watch a reading travel the whole way.",
    aside: "If you cut the gateway's power in the middle of a batch, the leaf buffers everything to disk and drains it once the gateway comes back. The failure drills in the repo run that exact sabotage for you.",
    rows: [
      ["Parts", "a Pi + the LoRa radio", gatewayGuide],
      ["Guide", "build the gateway", gatewayGuide],
      ["Then", "pair it with your leaf", pairingGuide],
    ],
    rule: null,
  },
  {
    n: "Tier 3", title: "The field node", cost: "not documented yet, on purpose",
    photo: null,
    body: "This is the solar-powered, weatherproof version. It uses a LiFePO4 battery, MPPT charging, an IP68 Pelican-style case, a pole mount, and a real SDI-12 sonde. The draft BOM comes to around $262 to $307 in parts, plus mounting hardware. I haven't run it through a full season of weather yet though, and I don't publish build guides for things I haven't built and broken myself first.",
    aside: "The design work is already public in the repo if you want to scout ahead or help test it. This section will become a real guide once the field trial is done, and the roadmap tracks where that stands.",
    rows: [
      ["Status", "field trial pending (roadmap)", repo],
    ],
    rule: null,
  },
];
---
<Base title="Build a Mycelium node" description="Build a Mycelium sensor node from off-the-shelf parts. Three tiers, from a ~$176 bench leaf you can build in an afternoon outward. No account, no subscription.">
  <SiteNav current="build" />

  <header class="page-head" id="main">
    <div class="wrap narrow">
      <h1>Build one.</h1>
      <p class="lede">Everything on this page is something you can actually do.
      There is no kit to order and no account to create. You buy off-the-shelf
      parts, follow the guide, and end up with a sensor node that delivers
      encrypted readings to a spreadsheet you own. Start at the bench and work
      outward from there.</p>
      <p class="beta mono">⚠ Mycelium is in beta. The first two tiers are
      documented from builds that exist and run today. The field tier only gets
      published once the field hardware has survived real weather.</p>
    </div>
  </header>

  <section class="tiers">
    <div class="wrap narrow">
      {tiers.map((t) => (
        <article class={`tier ${(t.img || t.photo) ? "" : "no-photo"}`}>
          <div class="tier-head">
            <span class="tier-n mono">{t.n}</span>
            <h2>{t.title}</h2>
            <span class="tier-cost mono">{t.cost}</span>
          </div>
          {t.img
            ? <figure class="photo">
                <img src={t.img} alt={t.alt} width="1600" height="1200" loading="lazy" />
                {t.caption && <figcaption class="ph-cap">{t.caption}</figcaption>}
              </figure>
            : t.photo
              ? <div class="photo-slot" aria-hidden="true"><span class="ph-lbl mono">photo</span><span class="ph-desc">{t.photo}</span></div>
              : <div class="photo-slot empty" aria-hidden="true"><span class="ph-desc">no field photo yet</span></div>}
          <div class="tier-body">
            <p>{t.body}</p>
            {t.aside && <p class="dim">{t.aside}</p>}
            <dl class="tier-rows mono">
              {t.rows.map(([k, v, href]) => (
                <div class="row">
                  <dt>{k}</dt>
                  <dd>{href ? <a href={href}>{v} →</a> : v}</dd>
                </div>
              ))}
            </dl>
            {t.rule && <p class="tier-rule small">{t.rule}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="connect">
    <div class="wrap narrow">
      <p class="connect-line">Built a leaf and a gateway? <a href={pairingGuide}>Pair them →</a>. It takes one shared identity hash and the two start talking to each other.</p>
    </div>
  </section>

  <section class="after" data-theme="paper">
    <div class="wrap narrow">
      <h2>After the build</h2>
      <p>Your node's readings are yours, and so is the network you are growing. If
      you find a rough edge in a guide, that is a bug, so <a href={repo}>file it
      like one</a>. If you built something I should know about, the same place
      works. There is no support tier because there is no product to support.
      There is just a repo, and now you are part of it.</p>
      <div class="ctas">
        <a class="btn-primary" href={repo}>Read the code</a>
        <a class="btn-ghost" href={`${base}/why`}>Why I'm building this →</a>
      </div>
    </div>
  </section>

  <SiteFooter />
</Base>

<style>
  .page-head { padding: var(--s-9) 8vw var(--s-6); }
  .page-head h1 { margin-bottom: var(--s-4); }
  .lede { font-size: clamp(1.05rem, 1.5vw, 1.25rem); color: var(--dim); max-width: 56ch; }
  .beta { margin-top: var(--s-5); padding: var(--s-3) var(--s-4); font-size: var(--t-small);
    color: var(--amber); border: 1px solid color-mix(in srgb, var(--amber) 35%, transparent);
    border-radius: var(--r-md); background: color-mix(in srgb, var(--amber) 7%, transparent); max-width: 64ch; }

  .tiers { padding-top: var(--s-6); }
  .tier { border: 1px solid var(--line); border-radius: var(--r-md); background: var(--bg-raise);
    padding: var(--s-6); margin-bottom: var(--s-5); display: grid; gap: var(--s-5);
    grid-template-columns: 1fr 1.1fr; align-items: start; }
  .tier.no-photo { grid-template-columns: 1fr; }
  .tier-head { grid-column: 1 / -1; display: flex; align-items: baseline; gap: var(--s-4); flex-wrap: wrap; }
  .tier-n { color: var(--accent); font-size: var(--t-small); letter-spacing: 0.08em; }
  .tier-head h2 { margin: 0; font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .tier-cost { color: var(--dim); font-size: var(--t-small); margin-left: auto; }
  .photo-slot { aspect-ratio: 16 / 10; border: 1px dashed color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: var(--r-sm); display: flex; flex-direction: column; align-items: center;
    justify-content: center; gap: var(--s-2); text-align: center; padding: var(--s-4);
    background: color-mix(in srgb, var(--accent) 3%, transparent); }
  .photo-slot.empty { border-style: solid; border-color: var(--line); }
  .ph-lbl { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .ph-desc { font-size: var(--t-small); color: var(--dim); max-width: 30ch; }
  .photo { margin: 0; }
  .photo img { display: block; width: 100%; height: auto; border-radius: var(--r-sm);
    border: 1px solid var(--line); }
  .ph-cap { margin-top: var(--s-2); font-size: var(--t-small); color: var(--dim); line-height: 1.4; }
  .tier-body p { max-width: none; }
  .tier-rows { margin: var(--s-4) 0 0; border-top: 1px solid var(--line); }
  .tier-rows .row { display: grid; grid-template-columns: 9rem 1fr; gap: var(--s-3);
    padding: var(--s-3) 0; border-bottom: 1px solid var(--line); font-size: var(--t-small); }
  .tier-rows dt { color: var(--dim); margin: 0; }
  .tier-rows dd { margin: 0; color: var(--ink); }
  .tier-rows a { color: var(--accent); }
  .tier-rule { margin-top: var(--s-4); color: var(--amber); }

  .connect { padding: var(--s-5) 8vw var(--s-6); text-align: center; }
  .connect-line { color: var(--dim); max-width: none; }
  .connect-line a { color: var(--accent); }

  .after .ctas { margin-top: var(--s-5); align-items: center; }
  .after .btn-ghost { color: var(--accent-deep); }

  @media (max-width: 720px) { .tier { grid-template-columns: 1fr; } }
</style>
