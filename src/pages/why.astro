---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
/* TEMPORARY under-construction placeholder. The full /why essay (creek
   story etc.) is preserved in git history — restore it with:
   git checkout <prior-commit> -- src/pages/why.astro */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/LBM-Labs/Mycelium_Network";
---
<Base title="Why — coming soon · LBM Labs" description="This page is under construction.">
  <SiteNav current="why" />

  <main class="uc" id="main">
    <div class="wrap narrow">
      <p class="kicker">Coming soon</p>
      <h1>This area is under construction.</h1>
      <p class="lede">This page isn't ready yet. In the meantime, you can
      <a href={`${base}/build`}>build a node</a> or
      <a href={repo}>read the code&nbsp;↗</a>.</p>
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  .uc { display: flex; align-items: center; min-height: 66vh; padding: var(--s-8) 8vw; }
  .uc h1 { margin: var(--s-3) 0 var(--s-4); }
  .uc .lede { font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--dim); max-width: 50ch; }
  .uc a { color: var(--accent); }
</style>
