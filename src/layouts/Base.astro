---
/* Base layout — head, fonts, global styles.
   Fonts: Inter (display + body) / IBM Plex Mono (evidence), per
   design-tokens.md. Conor preferred the original hero's clean sans
   headline over a serif, so no Fraunces. Loaded from Google Fonts for
   this review build; TODO E-phase: self-host via @fontsource. */
import "../styles/tokens.css";
import "../styles/global.css";

const {
  title = "Mycelium — the network for the Earth",
  description = "A free, open, encrypted telemetry mesh anyone can build. Ground truth for the places that need protecting, owned by no one.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" /><!-- pre-launch; removed at F-phase cutover -->

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0c120e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
