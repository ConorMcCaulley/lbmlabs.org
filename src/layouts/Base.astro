---
/* Base layout — head, fonts, global styles.
   Fonts: Inter (display + body) / IBM Plex Mono (evidence), per
   design-tokens.md. SELF-HOSTED via @fontsource — no third-party request
   (the site claims no analytics / no third parties, so it shouldn't ping
   Google Fonts), and faster. */
import "@fontsource-variable/inter";          // variable, covers 400–700 incl. the 650 headline
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/tokens.css";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const {
  title = "Mycelium — the network for the Earth",
  description = "A free, open, encrypted telemetry mesh anyone can build. Ground truth for the places that need protecting, owned by no one.",
} = Astro.props;
// absolute URL for the social-share card (og:image must be absolute)
const ogImage = new URL(`${base}/og.png`, Astro.site ?? "https://conormccaulley.github.io").href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" /><!-- pre-launch; removed at F-phase cutover -->

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LBM Labs" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0c120e" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
