---
/* D3 — Terrain cross-section / coverage compounds. A ridge and a canyon;
   nodes relay across it so the far side comes online by addition, not
   infrastructure. SCHEMATIC on purpose (claims gate) — a diagram, not a
   field measurement. */
---
<figure class="d3" role="img" aria-label="Schematic cross-section of a ridge and canyon with nodes relaying between them — a diagram, not a field measurement.">
  <svg viewBox="0 0 760 240" class="d3-svg" aria-hidden="true">
    <!-- terrain silhouette -->
    <path class="ground" d="M0,200 C90,120 150,110 220,150 C300,196 360,210 430,150 C500,92 560,96 650,150 C700,180 740,176 760,170 L760,240 L0,240 Z" />
    <!-- the mesh chain that bridges the canyon; nodes rest just above the surface -->
    <g class="mesh">
      <line x1="70"  y1="138" x2="150" y2="112" />
      <line x1="150" y1="112" x2="300" y2="178" />
      <line x1="300" y1="178" x2="430" y2="130" />
      <line x1="430" y1="130" x2="540" y2="94" />
      <line x1="540" y1="94"  x2="690" y2="156" />
    </g>
    <!-- nodes; last one (far side) is the gateway -->
    <circle cx="70"  cy="138" r="5" class="node" />
    <circle cx="150" cy="112" r="5" class="node" />
    <circle cx="300" cy="178" r="5" class="node" />
    <circle cx="430" cy="130" r="5" class="node" />
    <circle cx="540" cy="94"  r="5" class="node" />
    <circle cx="690" cy="156" r="9" class="gw" /><circle cx="690" cy="156" r="3.5" class="gwcore" />
    <!-- a reading hopping toward the gateway -->
    <circle r="3.5" class="pulse">
      <animateMotion dur="5s" repeatCount="indefinite"
        path="M70,138 L150,112 L300,178 L430,130 L540,94 L690,156" />
    </circle>
  </svg>
  <figcaption class="d3-cap mono">schematic — real range data will be provided once I've finished field testing.</figcaption>
</figure>

<style>
  .d3 { margin: var(--s-5) 0 0; }
  .d3-svg { width: 100%; height: auto; display: block; }
  .ground { fill: color-mix(in srgb, var(--accent) 6%, transparent); stroke: color-mix(in srgb, var(--accent) 18%, transparent); stroke-width: 1; }
  .mesh line { stroke: color-mix(in srgb, var(--accent) 45%, transparent); stroke-width: 1.3; }
  .node { fill: var(--accent); }
  .gw { fill: none; stroke: var(--accent); stroke-width: 1.4; }
  .gwcore { fill: var(--accent-hot); }
  .pulse { fill: var(--accent-hot); }
  .d3-cap { color: var(--text-dim); font-size: 12px; margin-top: var(--s-2); }
  @media (prefers-reduced-motion: reduce) { .pulse animateMotion { display: none; } .pulse { transform: translate(430px, 130px); } }
</style>
