---
/* D5 — what the relay carries vs what the owner reads. Top: the sealed
   envelope bytes a relay/gateway sees. Bottom: the plain reading, which
   only the owner's destination can produce.
   NOTE: the hex is a representative AES-256-GCM-shaped envelope
   (nonce | ciphertext | tag); a real captured envelope lands at publish
   (claims-gate V6). */
const hex = [
  "b6 b2 cf 9f e9 8c c2 a8 50 48 e0 59 4d 19 6c f1",
  "27 6f ec 8c c5 18 c0 dc 89 a9 c2 30 79 0d 6a f2",
  "87 71 28 30 cf 1f df 35 b4 d6 ff e4 22 8d 94 31",
  "5e 52 93 45 a6 37 3c cc f2 76 13 ad 5f ba 88 2d",
  "f7 f4 94 32 70 be b9 8c 94 23 07 cf 11 29 fb e0",
  "50 63 a3 36 11 ab fa",
];
---
<div class="d5" role="img" aria-label="Two rows of the same reading: the encrypted envelope bytes a relay carries, and the plain values only the owner can read.">
  <div class="d5-row d5-cipher">
    <span class="d5-lbl">what the relay sees</span>
    <pre class="mono">{hex.join("\n")}</pre>
  </div>
  <div class="d5-arrow" aria-hidden="true">decrypts only at your destination ↓</div>
  <div class="d5-row d5-plain">
    <span class="d5-lbl">what you see</span>
    <pre class="mono">2026-06-11 18:23 · leaf01 · temp_c · <span class="ok">18.16</span></pre>
  </div>
</div>

<style>
  .d5 { margin: var(--s-5) 0 0; }
  .d5-row { background: var(--section-raise); border: 1px solid var(--rule); border-radius: var(--r-md); padding: var(--s-5); }
  .d5-lbl { display: block; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); margin-bottom: var(--s-3); }
  .d5-row pre { margin: 0; font-size: var(--t-mono); line-height: 1.55; white-space: pre; overflow-x: auto; }
  .d5-cipher pre { color: var(--amber); }       /* ciphertext: amber, unreadable */
  .d5-plain pre { color: var(--text); }
  .d5-plain .ok { color: var(--accent); }
  [data-theme="paper"] .d5-plain .ok { color: var(--accent-deep); }
  .d5-arrow { font-family: var(--font-mono); font-size: 12px; color: var(--text-dim); text-align: center; padding: var(--s-3) 0; }
</style>
