---
/* D6 — cost over time. A commercial station's subscription keeps stacking
   year after year; a Mycelium node is its parts, once.
   Figures = verified C1 research (June 2026): HOBO RX3000 $1,049 + $110
   temp sensor = $1,159 hardware, + ~$399/yr data plan. Mycelium FIELD node
   ~$262–307 in parts (solar, weatherproof — the honest like-for-like vs a
   deployed commercial station; see docs/bom.md). NODE is the midpoint, used
   only to place the reference line; NODE_LABEL shows the range. Naming a
   vendor on the live site pending Conor's OK. */
const HW = 1159, SUB = 399, NODE = 285, YEARS = 5;
const NODE_LABEL = "$262–307";
const maxV = HW + SUB * YEARS;            // year-5 total
const H = 250, TOP = 20, BASE = 250, LEFT = 70, RIGHT = 748;
const innerH = BASE - TOP;
const y = (v) => BASE - (v / maxV) * innerH;
const slot = (RIGHT - LEFT) / (YEARS + 1);
const bw = Math.min(slot * 0.5, 46);
const bars = Array.from({ length: YEARS + 1 }, (_, yr) => {
  const cx = LEFT + slot * (yr + 0.5);
  const sub = SUB * yr;
  const hwY = y(HW);
  const subY = y(HW + sub);
  return {
    yr, cx,
    hwY, hwH: BASE - hwY,
    subY, subH: hwY - subY,
    topY: sub > 0 ? subY : hwY,   // top of the stacked bar, for the value label
    total: HW + sub,
  };
});
const nodeY = y(NODE);
const fmt = (n) => "$" + n.toLocaleString("en-US");   // $1,159 etc.
---
<figure class="d6" role="img" aria-label={`Chart: a commercial station costs about $${HW} in hardware plus about $${SUB} every year, stacking to roughly $${maxV} by year ${YEARS}, while a Mycelium field node is ${NODE_LABEL} in parts, once.`}>
  <svg viewBox="0 0 760 290" class="d6-svg" aria-hidden="true">
    <!-- baseline -->
    <line x1={LEFT} y1={BASE} x2={RIGHT} y2={BASE} class="axis" />
    <!-- bars -->
    {bars.map((b, i) => (
      <g class="bar" style={`--d:${i * 90}ms`}>
        <rect x={b.cx - bw / 2} y={b.hwY} width={bw} height={b.hwH} class="hw" />
        {b.subH > 0 && <rect x={b.cx - bw / 2} y={b.subY} width={bw} height={b.subH} class="sub" />}
        <text x={b.cx} y={BASE + 18} class="xlab">yr {b.yr}</text>
      </g>
    ))}
    <!-- running total above each bar (not animated, so it doesn't squash) -->
    {bars.map((b) => (
      <text x={b.cx} y={b.topY - 8} class={`barlab ${b.yr === 0 || b.yr === YEARS ? "key" : ""}`}>{fmt(b.total)}</text>
    ))}
    <!-- Mycelium flat reference -->
    <line x1={LEFT} y1={nodeY} x2={RIGHT} y2={nodeY} class="nodeline" />
    <text x={RIGHT} y={nodeY - 7} class="nodelab">Mycelium field node · {NODE_LABEL} · once</text>
  </svg>
  <div class="d6-key mono">
    <span><i class="sw hw"></i>hardware</span>
    <span><i class="sw sub"></i>subscription, stacking</span>
    <span><i class="sw node"></i>a Mycelium field node, once</span>
  </div>
  <figcaption class="d6-cap mono">a commercial station runs ~{fmt(HW)} up front, then ~{fmt(SUB)} every year — about {fmt(maxV)} by year {YEARS}. A Mycelium field node — solar, weatherproof — is {NODE_LABEL} in parts, once. <span class="dim">(prices as listed June 2026)</span></figcaption>
</figure>

<style>
  .d6 { margin: var(--s-5) 0 0; }
  .d6-svg { width: 100%; height: auto; display: block; }
  .axis { stroke: var(--rule); stroke-width: 1; }
  .hw { fill: color-mix(in srgb, var(--text-dim) 55%, transparent); }
  .sub { fill: var(--amber); }
  .bar { transform-origin: center bottom; animation: d6rise 700ms var(--d, 0ms) cubic-bezier(.2,.7,.2,1) both; }
  @keyframes d6rise { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .nodeline { stroke: var(--accent); stroke-width: 1.6; stroke-dasharray: 5 4; }
  [data-theme="paper"] .nodeline { stroke: var(--accent-deep); }
  .xlab { fill: var(--text-dim); font-family: var(--font-mono); font-size: 12px; text-anchor: middle; }
  .nodelab { fill: var(--accent); font-family: var(--font-mono); font-size: 12px; text-anchor: end; }
  [data-theme="paper"] .nodelab { fill: var(--accent-deep); }
  .barlab { fill: var(--text-dim); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .barlab.key { fill: var(--text); font-weight: 600; font-size: 12px; }
  [data-theme="paper"] .barlab.key { fill: var(--ink-dark); }
  .d6-key { display: flex; flex-wrap: wrap; gap: var(--s-4); font-size: 12px; color: var(--text-dim); margin-top: var(--s-3); }
  .d6-key .sw { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }
  .sw.hw { background: color-mix(in srgb, var(--text-dim) 55%, transparent); }
  .sw.sub { background: var(--amber); }
  .sw.node { background: var(--accent); }
  [data-theme="paper"] .sw.node { background: var(--accent-deep); }
  .d6-cap { color: var(--text-dim); font-size: 12px; margin-top: var(--s-3); max-width: 60ch; }
  @media (prefers-reduced-motion: reduce) { .bar { animation: none; } }
</style>
