---
/* The gap visual: broad (satellite) vs deep (a sensor).
   Broad = a coarse satellite raster of a lake with an algal bloom: the
   kind of thing visible from orbit, but only at low resolution. Deep =
   one node's nitrate trend that night — the driver a satellite can't see.
   Pixels are generated deterministically (no Math.random) so the build
   is reproducible. */
const P = 20;                       // pixel size — coarse on purpose
const COLS = 18, ROWS = 9;          // 360 x 180 viewBox
const lake = { cx: 206, cy: 96, rx: 120, ry: 60 };
const bloom = { cx: 250, cy: 78, r: 66 };
const inLake = (x, y) => ((x - lake.cx) / lake.rx) ** 2 + ((y - lake.cy) / lake.ry) ** 2 < 1;
const noise = (i, j) => { const v = Math.sin(i * 12.9898 + j * 78.233) * 43758.5453; return v - Math.floor(v); };
const LAND  = ["#b4bd9d", "#aab491", "#bdc6a8", "#a3ad88"];
const WATER = ["#6f8c95", "#7c98a0", "#688089"];
const BLOOM = ["#9ec24a", "#b0d257", "#8cb53c"];
const pixels = [];
for (let j = 0; j < ROWS; j++) {
  for (let i = 0; i < COLS; i++) {
    const x = i * P + P / 2, y = j * P + P / 2, n = noise(i, j);
    let pal = LAND;
    if (inLake(x, y)) {
      const db = Math.hypot(x - bloom.cx, y - bloom.cy) / bloom.r;
      pal = (db + (n - 0.5) * 0.55 < 1) ? BLOOM : WATER;   // ragged bloom edge
    }
    pixels.push({ x: i * P, y: j * P, c: pal[Math.floor(n * pal.length)] });
  }
}
// nitrate that night (mg/L NO₃), a spike the satellite can't see
const spark = [3.2, 3.0, 3.4, 3.3, 4.1, 5.4, 6.9, 8.0, 9.3, 10.4, 11.1];
const SW = 240, SH = 52, lo = 2.4, hi = 11.8;
const sx = (k) => 8 + k * (SW - 16) / (spark.length - 1);
const sy = (v) => 6 + (hi - v) / (hi - lo) * (SH - 12);
const sparkPts = spark.map((v, k) => `${sx(k).toFixed(0)},${sy(v).toFixed(0)}`).join(" ");
---
<div class="split">
  <div class="split-broad" role="img" aria-label="A coarse satellite image of a lake with a bright algal bloom — visible from orbit, but only at low resolution.">
    <svg class="sat" viewBox="0 0 360 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g>{pixels.map((p) => <rect x={p.x} y={p.y} width={P + 0.5} height={P + 0.5} fill={p.c} />)}</g>
      <!-- bloom callout -->
      <line class="cline" x1="120" y1="30" x2="226" y2="70" />
      <circle class="cdot" cx="226" cy="70" r="2.4" />
      <text class="ctxt" x="116" y="28" text-anchor="end">algal bloom</text>
    </svg>
    <span class="broad-note mono">satellite · broad · ≈ 250&nbsp;m/px</span>
  </div>
  <div class="split-deep" role="img" aria-label="One node's nitrate readings that night, rising from about 3 to 11 milligrams per liter — a spike a satellite cannot see.">
    <span class="d5-lbl mono">leaf01 · nitrate · every few minutes</span>
    <svg class="spark" viewBox="0 0 240 52" preserveAspectRatio="none" aria-hidden="true">
      <polyline points={sparkPts} />
    </svg>
    <p class="reading mono">20:10 <span class="ok">3.4</span> · 21:10 6.9 ·
    22:10 9.3 · 22:40 <span class="warn">11.1</span> <span class="unit">mg/L&nbsp;NO₃</span></p>
  </div>
</div>

<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); margin: var(--s-5) 0 var(--s-3); }
  .split > div { border: 1px solid var(--rule); border-radius: var(--r-md); min-height: 172px; }

  .split-broad { position: relative; overflow: hidden; }
  .split-broad .sat { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .split-broad .cline { stroke: #1b2714; stroke-width: 1.2; opacity: 0.7; }
  .split-broad .cdot  { fill: #1b2714; }
  .split-broad .ctxt  { fill: #16210f; font-family: var(--font-mono); font-size: 11px;
    paint-order: stroke; stroke: #eef1e6; stroke-width: 3px; stroke-linejoin: round; }
  .split-broad .broad-note { position: absolute; left: 10px; bottom: 10px; z-index: 2;
    font-size: 11px; color: #1d2620; background: color-mix(in srgb, #f1eee4 80%, transparent);
    padding: 3px 7px; border-radius: 5px; }

  .split-deep { background: var(--section-raise); padding: var(--s-4);
    display: flex; flex-direction: column; justify-content: flex-end; gap: var(--s-2); }
  .split-deep .d5-lbl { color: var(--accent-deep); font-size: 12px; }
  .split-deep .spark { width: 100%; height: 46px; display: block; }
  .split-deep .spark polyline { fill: none; stroke: var(--accent-deep); stroke-width: 1.6;
    stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .split-deep .reading { font-size: 0.95rem; margin: 0; color: var(--text); }
  .split-deep .ok { color: var(--accent-deep); }
  .split-deep .warn { color: var(--ember); font-weight: 600; }
  .split-deep .unit { color: var(--text-dim); }

  @media (max-width: 720px) { .split { grid-template-columns: 1fr; } }
</style>
